{% from 'macros.twig' import btn %}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fate/GO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet">
    <style>
        .navbar { border-bottom: 3px solid #e8a020; }
        .navbar-brand i { color: #e8a020; font-size: 1.4rem; }
        .navbar .nav-link { color: #333; font-size: 0.95rem; }
        .navbar .nav-link.active { font-weight: 700; color: #000 !important; }
        .navbar .nav-link:hover { color: #e8a020 !important; }
        .nav .nav-link:hover { background-color: #0d6efd; color: #fff !important; border-radius: 4px; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="fa-solid fa-star-and-crescent"></i></a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link {{ title == 'Главная' ? 'active' }}" href="/">Главная</a>
                </li>
                {% for type in types %}
                    <li class="nav-item">
                        <a class="nav-link" href="/?type={{ type.title }}">{{ type.title|title }}</a>
                    </li>
                {% endfor %}
                <li class="nav-item">
                    <a class="nav-link" href="/search">Поиск</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/fate-object/create">Добавить героя</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/fate-type/create">Добавить тип</a>
                </li>
            </ul>
            <div class="d-flex gap-2 ms-3">
                <form action="/set-welcome">
                    <input type="text" name="message" class="form-control">
                </form>
                <div class="pt-1">
                    {{ btn('Выйти', '/logout', true, 'danger') }}
                </div>
            </div>
        </div>
    </div>
</nav>

<div class="container pt-3 pb-3">
    <div class="row">
        <div class="col-9">
            {% block content %}
            {% endblock %}
        </div>
        <div class="col-3">
            <p><strong>Последние страницы которые вы посетили</strong></p>
            {% if history %}
                {% for url in history %}
                    <div class="bg-light p-2 mb-1 rounded" style="word-break: break-all;">
                        <a href="{{ url }}">{{ url }}</a>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>

</body>
</html>