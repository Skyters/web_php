{% extends "__layout.twig" %}
{% from 'macros.twig' import btn %}

{% block content %}
    <h1>Редактирование героя</h1>
    <hr>

    <form action="" enctype="multipart/form-data" method="POST" class="row g-3">
        <input type="hidden" name="current_image" value="{{ object.image }}">
        <div class="col-4">
            <label class="form-label">Название</label>
            <input type="text" class="form-control" name="title" value="{{ object.title }}">
        </div>
        <div class="col-4">
            <label class="form-label">Краткое описание</label>
            <input type="text" class="form-control" name="description" value="{{ object.description }}">
        </div>
        <div class="col-4">
            <label class="form-label">Тип</label>
            <select class="form-control" name="type">
                {% for type in types %}
                    <option value="{{ type.title }}" {% if type.title == object.type %}selected{% endif %}>
                        {{ type.title|title }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Картинка</label>
            <input class="form-control" type="file" name="image">
        </div>
        <div class="col-12">
            <textarea name="info" placeholder="Полное описание..." class="form-control" rows="5">{{ object.info }}</textarea>
        </div>
        <div class="col-12 text-end">
            {{ btn('Сохранить', '#', true) | replace({'href="#"': 'href="#" onclick="this.closest(\'form\').submit(); return false;"'}) | raw }}
        </div>
    </form>
{% endblock %}