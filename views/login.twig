{% extends '__layout.twig' %}
{% from 'macros.twig' import btn %}

{% block content %}
<h1>Вход</h1>
<hr>

{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}

<form action="" method="POST" class="row g-3" style="max-width: 400px;">
    <div class="col-12">
        <label class="form-label">Логин</label>
        <input type="text" class="form-control" name="username">
    </div>
    <div class="col-12">
        <label class="form-label">Пароль</label>
        <input type="password" class="form-control" name="password">
    </div>
    <div class="col-12">
        {{ btn('Войти', '#', true) | replace({'href="#"': 'href="#" onclick="this.closest(\'form\').submit(); return false;"'}) | raw }}
    </div>
</form>
{% endblock %}