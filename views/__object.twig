{% extends '__layout.twig' %}
{% from 'macros.twig' import btn %}

{% block content %}

<h1>{{ object.title }}</h1>
<p>{{ object.description }}</p>

<ul class="nav mb-3">
    <li class="nav-item">
        {{ btn('Картинка', '/fate-object/' ~ object.id ~ '?show=image', current_url starts with '/fate-object/' ~ object.id ~ '?show=image') }}
    </li>
    <li class="nav-item">
        {{ btn('Описание', '/fate-object/' ~ object.id ~ '?show=info', current_url starts with '/fate-object/' ~ object.id ~ '?show=info') }}
    </li>
</ul>

{% block object_content %}
    <div class="border rounded p-3 text-muted">
        Выберите вверху какую информацию хотите посмотреть =O
    </div>
{% endblock %}

{% endblock %}